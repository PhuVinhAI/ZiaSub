# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Generated native module build artifacts
packages/mobile/modules/**/android/build/
packages/mobile/modules/**/ios/build/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Release signing credentials (never commit)
packages/mobile/release-signing/

# typescript
*.tsbuildinfo

# Build outputs
packages/shared/dist/
packages/extension/dist/

# Lock files (use bun.lockb)
package-lock.json
yarn.lock

.master-context
